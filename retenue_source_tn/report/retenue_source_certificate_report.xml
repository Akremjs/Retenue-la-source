<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_retenue_certificate_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="text-center">Certificat de retenue à la source</h2>
                <p class="text-center text-muted">République Tunisienne — Article 55 CIRPP / TEJ</p>
                <div class="row mt-4 mb-3">
                    <div class="col-6">
                        <strong>N° certificat :</strong>
                        <span t-field="doc.certificate_number"/>
                    </div>
                    <div class="col-6 text-end">
                        <strong>Date de règlement :</strong>
                        <span t-field="doc.date_reglement"/>
                    </div>
                </div>

                <h4>Déclarant</h4>
                <p>
                    <span t-field="doc.company_id.name"/><br/>
                    Matricule :
                    <span t-esc="doc.company_id.vat or ''"/><br/>
                    <span t-field="doc.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                </p>

                <h4>Bénéficiaire</h4>
                <p>
                    <span t-field="doc.partner_id.name"/><br/>
                    Identifiant :
                    <span t-esc="doc.partner_id.vat or doc.partner_id.ref or ''"/><br/>
                    <span t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                </p>

                <h4>Opération</h4>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Facture</th>
                            <th>Type TEJ</th>
                            <th>Base / HT</th>
                            <th>Taux</th>
                            <th>Montant RAS</th>
                            <th>Net servi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span t-field="doc.invoice_id.name"/></td>
                            <td>
                                <span t-field="doc.rs_type_id.display_name"/>
                                <t t-if="doc.rs_type_id.tej_code">
                                    (<span t-field="doc.rs_type_id.tej_code"/>)
                                </t>
                            </td>
                            <td><span t-field="doc.withholding_base_amount"/></td>
                            <td><span t-esc="'%.3f' % (doc.tax_rate or 0)"/> %</td>
                            <td><span t-field="doc.withholding_tax_amount"/></td>
                            <td><span t-field="doc.amount_net_served"/></td>
                        </tr>
                    </tbody>
                </table>

                <p class="mt-4">
                    Référence interne : <span t-field="doc.name"/><br/>
                    Mémo : <span t-field="doc.memo"/>
                </p>
                <p class="text-muted mt-5">
                    Document généré depuis Odoo — à archiver / déposer via la plateforme TEJ
                    (https://tej.finances.gov.tn) selon le cahier des charges officiel.
                </p>
            </div>
        </t>
    </template>

    <template id="report_retenue_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="retenue_source_tn.report_retenue_certificate_document"/>
            </t>
        </t>
    </template>
</odoo>
