<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retenu_source_wizard_form" model="ir.ui.view">
        <field name="name">retenu.source.wizard.form</field>
        <field name="model">retenue.source.wizard</field>
        <field name="arch" type="xml">
            <form string="Retenue à la source">
                <group>
                    <group>
                        <field name="invoice_id"/>
                        <field name="move_type"/>
                        <field name="rs_allowed_payment_journal_ids" invisible="1"/>
                        <field name="rs_allowed_withholding_tax_ids" invisible="1"/>
                        <field name="payment_journal_id" domain="[('id', 'in', rs_allowed_payment_journal_ids)]"/>
                        <field name="date_reglement"/>
                        <field name="memo"/>
                    </group>
                    <group>
                        <field
                            name="withholding_tax_id"
                            domain="[('id', 'in', rs_allowed_withholding_tax_ids)]"
                            invisible="not payment_journal_id"
                            required="payment_journal_id"
                        />
                        <field name="rs_type_id" invisible="not withholding_tax_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="withholding_number" invisible="not payment_journal_id"/>
                        <field name="withholding_base_amount" invisible="not payment_journal_id"/>
                        <field name="rs_threshold_amount" invisible="not payment_journal_id"/>
                        <field name="rs_below_threshold" invisible="1"/>
                        <field name="withholding_tax_amount" invisible="1"/>
                        <field name="payment_amount" invisible="not payment_journal_id"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not rs_below_threshold">
                    Base sous le seuil RAS configuré.
                </div>
                <footer>
                    <button name="action_create_retenu_record" type="object" string="Créer" class="btn-primary"/>
                    <button string="Annulér" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
