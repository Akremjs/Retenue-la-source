<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_retenue_source" model="ir.ui.view">
        <field name="name">res.partner.form.retenue.source</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='purchase']" position="after">
                <group string="Retenue à la source" name="retenue_source_tn">
                    <field name="rs_retenue_exempt"/>
                    <field name="rs_retenue_exempt_reason" invisible="not rs_retenue_exempt"/>
                    <field name="rs_tej_id_type"/>
                    <field name="rs_tej_category"/>
                    <field name="rs_tej_resident"/>
                    <field name="rs_tej_activity"/>
                    <field name="rs_tej_birth_date" invisible="rs_tej_id_type not in ('2', '3', '4')"/>
                    <field name="rs_tej_id_country_id" invisible="rs_tej_id_type in ('1', '2')"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
