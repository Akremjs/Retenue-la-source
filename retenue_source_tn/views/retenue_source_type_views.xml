<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retenue_source_type_tree" model="ir.ui.view">
        <field name="name">retenue.source.type.tree</field>
        <field name="model">retenue.source.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="rate"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_retenue_source_type_form" model="ir.ui.view">
        <field name="name">retenue.source.type.form</field>
        <field name="model">retenue.source.type</field>
        <field name="arch" type="xml">
            <form string="Type operation RAS">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="rate"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_retenue_source_type" model="ir.actions.act_window">
        <field name="name">Types d'opération TEJ</field>
        <field name="res_model">retenue.source.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_retenue_source_type"
        name="Types d'opération TEJ"
        parent="account.menu_finance_configuration"
        action="action_retenue_source_type"
        sequence="95"
    />
</odoo>
