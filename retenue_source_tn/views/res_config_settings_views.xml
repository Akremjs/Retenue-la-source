<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_retenue_source" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.retenue.source</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Retenue à la source (Tunisie)" name="retenue_source_tn_settings">
                    <setting string="Seuil RAS" help="Montant minimum de base pour appliquer la RAS (défaut 1000).">
                        <field name="rs_threshold_amount"/>
                    </setting>
                    <setting string="Bloquer sous seuil" help="Empêche la creation d'une RAS si la base est sous le seuil.">
                        <field name="rs_enforce_threshold"/>
                    </setting>
                    <setting string="Exiger matricule fiscal" help="Exige le champ VAT / matricule sur le partenaire.">
                        <field name="rs_require_partner_vat"/>
                    </setting>
                    <setting string="TEJ déclarant" help="Identifiant et catégorie du déclarant pour l'export XML.">
                        <field name="rs_tej_id_type"/>
                        <field name="rs_tej_category"/>
                        <field name="rs_tej_schema_version"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
