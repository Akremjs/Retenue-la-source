<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_retenu_source_record_sale" model="ir.sequence">
        <field name="name">Retenue source - Clients</field>
        <field name="code">retenue.source.record.sale</field>
        <field name="prefix">RETV/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_retenu_source_record_purchase" model="ir.sequence">
        <field name="name">Retenue source - Fournisseurs</field>
        <field name="code">retenue.source.record.purchase</field>
        <field name="prefix">RETA/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_retenue_source_certificate" model="ir.sequence">
        <field name="name">Certificat RAS</field>
        <field name="code">retenue.source.certificate</field>
        <field name="prefix">CERT-RAS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_retenue_source_declaration" model="ir.sequence">
        <field name="name">Déclaration mensuelle RAS</field>
        <field name="code">retenue.source.declaration</field>
        <field name="prefix">DECL-RAS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
