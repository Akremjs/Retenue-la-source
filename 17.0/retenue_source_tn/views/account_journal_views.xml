<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_retenu_source" model="ir.ui.view">
        <field name="name">account.journal.form.retenu.source</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']" position="inside">
                    <group string="Retenue à la source">
                        <field name="rs_withholding_sales"/>
                        <field name="rs_withholding_purchases"/>
                    </group>
            </xpath>
        </field>
    </record>
</odoo>
